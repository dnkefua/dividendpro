# Public Firebase browser metadata. These are the only credential-like values
# intentionally exposed through Vite.
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="dividendpro-3b397.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="dividendpro-3b397"
VITE_FIREBASE_STORAGE_BUCKET="dividendpro-3b397.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="539817560279"

# Server-only configuration. Provision secrets through Cloud Secret Manager;
# never add a VITE_ prefix.
FIREBASE_PROJECT_ID="dividendpro-3b397"
BSC_RPC_URL="https://bsc-dataseed1.binance.org/"
GEMINI_API_KEY="server_secret_from_secret_manager"
TELEGRAM_BOT_TOKEN="server_secret_from_secret_manager"
TELEGRAM_CHAT_ID="server_managed_destination"

# Native Rust/C++ MEV control plane. Tokens are server-only Secret Manager
# values. The execution private key is non-exportable in Cloud KMS; the server
# receives only its key-version resource name and derived public address. Keep
# live execution false until every canary gate passes.
MEV_ORCHESTRATOR_URLS_JSON='[{"region":"local","url":"http://127.0.0.1:8081"}]'
MEV_SERVICE_TOKEN="minimum_32_character_server_to_server_secret"
MEV_EXECUTOR_INTERNAL_TOKEN="separate_minimum_32_character_internal_secret"
MEV_LIVE_EXECUTION_ENABLED="false"
MEV_KMS_KEY_VERSION="projects/dividendpro-3b397/locations/us-east4/keyRings/dividendpro-production/cryptoKeys/mev-executor-signer/cryptoKeyVersions/1"
MEV_EXECUTION_SIGNER_ADDRESS="kms_derived_public_bsc_address"
MEV_EXECUTOR_ADDRESS="deployed_atomic_executor_address"
MEV_ROUTER_ALLOWLIST="comma_separated_audited_router_addresses"
MEV_TOKEN_ALLOWLIST="comma_separated_supported_token_addresses"
MEV_PROFIT_RECIPIENT_ALLOWLIST="comma_separated_owner_approved_recipients"
MEV_MAX_GAS_LIMIT="1200000"
MEV_MAX_LIVE_NOTIONAL_USD_MICROS="25000000"

# Worker-only configuration. In GCP, store complete values in the regional
# mev-worker-config-* secrets referenced by infra/terraform/mev.
MEV_REGION="local"
MEV_RELAYS_JSON='[]'
MEV_SCANNER_CONFIG_JSON='{"enabled":false}'
MEV_SCANNER_PROFIT_RECIPIENT="owner_approved_profit_wallet"

APP_URL="http://localhost:3000"
