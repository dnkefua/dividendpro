# Official Hummingbot Gateway Dockerfile for Google Cloud Run
FROM hummingbot/hummingbot:latest

# Expose REST Gateway API Ports
EXPOSE 8080
EXPOSE 15888

# Environment variables for Cloud Run
ENV PORT=8080
ENV ALLOW_TELEMETRY=false

# CONFIG_PASSWORD must be injected from Secret Manager at deployment time.

# Start Hummingbot Gateway REST Server
CMD ["python3", "bin/hummingbot.py", "--gateway"]
